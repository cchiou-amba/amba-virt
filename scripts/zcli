#!/bin/sh
# Launch an authenticated zcli against ZEDEDA Cloud.
# Token is never stored here. ZCLI_TOKEN must already be in the environment.
#
#   ./scripts/zcli
#       Interactive bash + autocomplete (needs a TTY).
#   ./scripts/zcli -- <zcli-args...>
#       Configure, run that command, print stdout. No TTY.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
mkdir -p "$ROOT/models" "$ROOT/apps"
# Must export: docker -e NAME only reads the process environment.
export ZCLI_SERVER="${ZCLI_SERVER:-zedcontrol.gmwtus.zededa.net}"

if [ -z "${ZCLI_TOKEN:-}" ]; then
	echo "scripts/zcli: set ZCLI_TOKEN (do not commit it)" >&2
	exit 1
fi

ONESHOT=0
if [ "${1:-}" = "--" ]; then
	shift
	ONESHOT=1
	if [ "$#" -eq 0 ]; then
		echo "scripts/zcli: missing command after --" >&2
		exit 1
	fi
elif [ "$#" -gt 0 ]; then
	echo "scripts/zcli: one-shot commands go after --" >&2
	exit 1
fi

if [ "$ONESHOT" -eq 0 ]; then
	if [ ! -t 0 ]; then
		echo "scripts/zcli: needs a TTY (run from a terminal)" >&2
		exit 1
	fi
	# The image's interactive front-end is bash + autocomplete, not `zcli`
	# with no args (that only prints help). Configure is non-interactive
	# when --server and --token are actually present.
	exec docker run --rm -it \
		--entrypoint sh \
		-e ZCLI_TOKEN \
		-e "ZCLI_SERVER=$ZCLI_SERVER" \
		-v "$ROOT/models:/home/zcli/models:ro" \
		-v "$ROOT/apps:/home/zcli/apps:ro" \
		zededa/zcli:latest \
		-c 'zcli configure --server="$ZCLI_SERVER" --token="$ZCLI_TOKEN" --output=text && exec /bin/bash --rcfile /zcli/zcli.bash'
fi

# One-shot: no TTY, no -t. Configure chatter goes to stderr so JSON on
# stdout stays parseable. Host captures stdout; nothing is written here.
# $0 inside -c is the dummy "zcli"; "$@" are the caller args.
exec docker run --rm \
	--entrypoint sh \
	-e ZCLI_TOKEN \
	-e "ZCLI_SERVER=$ZCLI_SERVER" \
	-v "$ROOT/models:/home/zcli/models:ro" \
	-v "$ROOT/apps:/home/zcli/apps:ro" \
	zededa/zcli:latest \
	-c 'zcli configure --server="$ZCLI_SERVER" --token="$ZCLI_TOKEN" --output=text >&2 && exec zcli "$@"' \
	zcli "$@"
