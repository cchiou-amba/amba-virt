# /etc/amba-virt/camera.conf: live camera config for amba-virt-server.
#
# Copy this file to /etc/amba-virt/camera.conf once per board to turn the
# camera pipeline on. The package never installs the live file. This example
# is for the OS08A10 Port A boards in the lab.
#
# Copyright (C) 2026, Ambarella International LLC

firmware_dir=/usr/lib/amba-virt/firmware
# The resource script is amba-virt's own: Cooper's n1_655_vin0_1080p_linear.lua plus a JPEG decoder channel on a
# virtual video source (the ambds module in late-modules.conf), which gives guests hardware JPEG decode beside the
# camera. For the plain camera pipeline without a decoder use /usr/share/ambarella/lua_scripts/n1_655_vin0_1080p_linear.lua.
resource_script=/usr/share/amba-virt/lua_scripts/n1_655_vin0_1080p_linear_plus_jpeg_decoder.lua
vout_script=/usr/share/ambarella/lua_scripts/vout0_dsi.lua
app_img_profile=10
poc_chip=/dev/gpiochip0
poc_lines=92 93 98 99
poc_settle_ms=4000
early_modules=/etc/amba-virt/early-modules.conf
late_modules=/etc/amba-virt/late-modules.conf
aaa_bin=/usr/bin/amba-virt-aaa
monitor_bin=/usr/bin/dsp_monitor_service
