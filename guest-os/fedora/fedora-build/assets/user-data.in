#cloud-config
hostname: fedora

users:
  - name: fedora
    lock_passwd: false
    passwd: "$6$Ambarel2$/XLykOBgeofTGqNPxBGw3qvUyNTBTAf9UnoPq2.FW82o59KNLNV4NbEUPeh41bz6u5R8jILCVo0lFGBZNnHHG0"
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash

chpasswd:
  expire: false
  users:
    - name: fedora
      password: fedora
      type: text

write_files:
  - path: /etc/systemd/system/amba-image-provision.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Ambarella Image Provisioning Service
      After=cloud-final.service
      Wants=cloud-final.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/provision-image.sh
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/sbin/grow-rootfs.sh
    permissions: '0755'
    encoding: b64
    content: @GROW_ROOTFS_SH_B64@

  - path: /etc/systemd/system/grow-rootfs.service
    permissions: '0644'
    encoding: b64
    content: @GROW_ROOTFS_SERVICE_B64@

  - path: /etc/systemd/system/ssh-hostkeys.service
    permissions: '0644'
    encoding: b64
    content: @SSH_HOSTKEYS_SERVICE_B64@

  - path: /tmp/assets/10-ambarella.network
    permissions: '0644'
    encoding: b64
    content: @NETWORK_UNIT_B64@

  - path: /usr/local/sbin/provision-image.sh
    permissions: '0755'
    encoding: b64
    content: @PROVISION_IMAGE_SH_B64@

runcmd:
  - systemctl daemon-reload
  - systemctl enable --no-block amba-image-provision.service
  - systemctl start --no-block amba-image-provision.service
