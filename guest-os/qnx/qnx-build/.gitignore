# Build outputs and temporary artifacts
output/
dist/
*.qcow2
*.raw
*.bin
*.img
*.vmdk

# Patch backups and Python cache
*.orig
__pycache__/
*.pyc

# Proprietary binary patches
patches/*.patched

# Credentials, keys, and security sensitive files
local/misc_files/ssh_host_*
local/misc_files/qtd_*
local/misc_files/shadow
local/misc_files/authorized_keys
local/ssh-ident

# Editor backups
*~
*.swp
.tmp*
