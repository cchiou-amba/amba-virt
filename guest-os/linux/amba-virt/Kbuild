# Ambarella Virtualization Linux Guest Driver Kbuild

ccflags-y += -I$(src)/include/uapi -I$(src) -DAMBA_VIRT_GUEST
# The shared Nanopb and iav_slice_client sources include libc headers; the kernel build has none (-nostdinc)
ccflags-y += -I$(src)/include/libc-shim
ccflags-y += -I$(src)/../../../third_party/nanopb
ccflags-y += -I$(src)/../../../protocol/amba_virt/generated
ccflags-y += -I$(src)/../../../drivers/amba_virt/tools

obj-m := amba_virt.o
amba_virt-y := amba_virt_hvm.o amba_virt_core.o amba_virt_iav_slice.o
amba_virt-y += amba_virt_pb_common.o amba_virt_pb_encode.o amba_virt_pb_decode.o
amba_virt-y += amba_virt_pb_msgs.o amba_virt_iav_slice_client.o
