"\n"
"    function toHex8(val) {\n"
"      const num = Number(val) >>> 0;\n"
"      return '0x' + num.toString(16).padStart(8, '0');\n"
"    }\n"
"\n"
"    function formatHex64(val) {\n"
"      const n = Number(val);\n"
"      if (!Number.isFinite(n) || n < 0) return '0x00000000';\n"
"      if (n <= 0xffffffff) return toHex8(n);\n"
"      return '0x' + Math.trunc(n).toString(16);\n"
"    }\n"
"\n"
"    function formatBytesMb(bytes) {\n"
"      const n = Number(bytes) || 0;\n"
"      const mb = (n / (1024 * 1024)).toFixed(2);\n"
"      return `${mb} MB (${n.toLocaleString()} B)`;\n"
"    }\n"
"\n"
"    function classifySegmentClass(ext) {\n"
"      if (!ext || !ext.partition) return 'seg-gap';\n"
"      const u = String(ext.usage || '');\n"
"      if (u.includes('RPC Arena')) return 'seg-arena';\n"
"      if (u.startsWith('CAVALRY')) return 'seg-cavalry';\n"
"      if (u.startsWith('GDMA')) return 'seg-gdma';\n"
"      if (u.startsWith('IAV')) return 'seg-iav';\n"
"      if (u.startsWith('SCRATCH')) return 'seg-scratch';\n"
"      return 'seg-cavalry';\n"
"    }\n"
"\n"
"    function renderGuestProps(data) {\n"
"      if (!data || !data.online) {\n"
"        propsErrorCard.style.display = 'flex';\n"
"        const statusInfo = (data && typeof data.query_status === 'number') ? ` (status ${data.query_status})` : '';\n"
"        const errMsg = (data && data.error) ? String(data.error) : 'Unable to query /dev/amba_virt';\n"
"        propsErrorText.textContent = errMsg + statusInfo;\n"
"        propsOnlineContent.style.display = 'none';\n"
"        return;\n"
"      }\n"
"\n"
"      propsErrorCard.style.display = 'none';\n"
"      propsOnlineContent.style.display = 'flex';\n"
"\n"
"      propTenantCid.textContent = String(data.tenant_cid);\n"
"      propTenantIdx.textContent = String(data.tenant_idx);\n"
"      propServerReachable.textContent = 'ONLINE (Server reachable)';\n"
"\n"
"      const barBytes = Number(data.bar_size_bytes) || 0;\n"
"      const partBytes = Number(data.partition_bytes) || 0;\n"
"      const barMbRound = Math.round(barBytes / (1024 * 1024));\n"
"      propBarSize.textContent = `${barMbRound} MB (${formatHex64(barBytes)})`;\n"
"\n"
"      const pct = barBytes > 0 ? Math.min(100, (partBytes * 100) / barBytes) : 0;\n"
"      const partMb = (partBytes / (1024 * 1024)).toFixed(2);\n"
"      propPartitionUsage.textContent = `${partMb} MB (${pct.toFixed(1)}%)`;\n"
"      propPartitionGauge.style.width = `${pct.toFixed(1)}%`;\n"
"      propServerAllocMb.textContent = `${Number(data.server_allocated_mb) || 0} MB`;\n"
"      propCapsHex.textContent = String(data.caps_hex || '0x00000000');\n"
"\n"
"      propCapsList.replaceChildren();\n"
"      const capNames = Array.isArray(data.cap_names) ? data.cap_names : [];\n"
"      if (capNames.length === 0) {\n"
"        const nonePill = document.createElement('span');\n"
"        nonePill.className = 'cap-pill';\n"
"        nonePill.textContent = 'NONE';\n"
"        propCapsList.appendChild(nonePill);\n"
"      } else {\n"
"        capNames.forEach((name) => {\n"
"          const pill = document.createElement('span');\n"
"          pill.className = 'cap-pill';\n"
"          pill.textContent = String(name);\n"
"          propCapsList.appendChild(pill);\n"
"        });\n"
"      }\n"
"      if (data.caps_unknown_hex && data.caps_unknown_hex !== '0x00000000') {\n"
"        const unkPill = document.createElement('span');\n"
"        unkPill.className = 'cap-pill unknown';\n"
"        unkPill.textContent = `UNKNOWN (${String(data.caps_unknown_hex)})`;\n"
"        propCapsList.appendChild(unkPill);\n"
"      }\n"
"\n"
"      propMapBar.replaceChildren();\n"
"      const extents = Array.isArray(data.extents) ? data.extents : [];\n"
"      extents.forEach((ext) => {\n"
"        const start = Number(ext.start_offset) || 0;\n"
"        const end = Number(ext.end_offset) || 0;\n"
"        const len = Math.max(0, end - start);\n"
"        const sharePct = barBytes > 0 ? (len * 100) / barBytes : 100;\n"
"        const block = document.createElement('div');\n"
"        block.className = 'bar-segment ' + classifySegmentClass(ext);\n"
"        if (ext.clipped || ext.overlaps) {\n"
"          block.classList.add('seg-anomaly');\n"
"        }\n"
"        block.style.width = `${Math.max(sharePct, 0.25).toFixed(3)}%`;\n"
"        const flags = [];\n"
"        if (ext.clipped) flags.push('CLIPPED');\n"
"        if (ext.overlaps) flags.push('OVERLAPS');\n"
"        const flagSuffix = flags.length ? ` [${flags.join(', ')}]` : '';\n"
"        block.title = `${String(ext.usage)}: ${formatHex64(start)} - ${formatHex64(end)} (${formatBytesMb(len)})${flagSuffix}`;\n"
"        if (sharePct >= 8) {\n"
"          block.textContent = String(ext.usage);\n"
"        }\n"
"        propMapBar.appendChild(block);\n"
"      });\n"
"\n"
"      propDevicesBody.replaceChildren();\n"
"      const devices = Array.isArray(data.devices) ? data.devices : [];\n"
"      propDevicesCount.textContent = `${devices.length} ${devices.length === 1 ? 'device' : 'devices'}`;\n"
"      if (devices.length === 0) {\n"
"        const tr = document.createElement('tr');\n"
"        const td = document.createElement('td');\n"
"        td.colSpan = 5;\n"
