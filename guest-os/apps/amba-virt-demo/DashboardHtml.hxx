"        tr.appendChild(td);\n"
"        propDevicesBody.appendChild(tr);\n"
"      } else {\n"
"        devices.forEach((dev) => {\n"
"          const tr = document.createElement('tr');\n"
"          const tdType = document.createElement('td');\n"
"          tdType.textContent = `${String(dev.dev_type_name)} (ID ${Number(dev.dev_type)})`;\n"
"          const tdBase = document.createElement('td');\n"
"          tdBase.className = 'mono-cell';\n"
"          tdBase.textContent = formatHex64(dev.base_offset);\n"
"          const tdEnd = document.createElement('td');\n"
"          tdEnd.className = 'mono-cell';\n"
"          tdEnd.textContent = formatHex64(dev.end_offset);\n"
"          const tdSize = document.createElement('td');\n"
"          tdSize.className = 'mono-cell';\n"
"          tdSize.textContent = formatBytesMb(dev.size_bytes);\n"
"          const tdArena = document.createElement('td');\n"
"          tdArena.className = 'mono-cell';\n"
"          if (Number(dev.rpc_arena_size) > 0) {\n"
"            tdArena.textContent = `${formatHex64(dev.rpc_arena_offset)} (${formatBytesMb(dev.rpc_arena_size)})`;\n"
"          } else {\n"
