"      max-width: 100%;\n"
"      max-height: 520px;\n"
"      height: auto;\n"
"      object-fit: contain;\n"
"      border-radius: 8px;\n"
"      display: none;\n"
"    }\n"
"\n"
"    footer {\n"
"      padding: 1rem 2rem;\n"
"      border-top: 1px solid var(--border);\n"
"      font-size: 0.78rem;\n"
"      color: var(--text-sub);\n"
"      display: flex;\n"
"      justify-content: space-between;\n"
"      gap: 0.75rem;\n"
"      background: rgba(11, 16, 28, 0.5);\n"
"    }\n"
"\n"
"    /* Touch Targets & Platform Rules */\n"
"    .touch-view .tab-btn,\n"
"    .touch-view .btn-action,\n"
"    .touch-view .btn-secondary,\n"
"    .touch-view select,\n"
"    .touch-view .touch-control {\n"
"      min-height: 44px;\n"
"      min-width: 44px;\n"
"    }\n"
"    .touch-view input[type=range]::-webkit-slider-thumb {\n"
"      width: 24px;\n"
"      height: 24px;\n"
"    }\n"
"    .touch-view input[type=range]::-moz-range-thumb {\n"
"      width: 24px;\n"
"      height: 24px;\n"
"    }\n"
"    .platform-ios select,\n"
"    .platform-ios input,\n"
"    .platform-ios button,\n"
"    .mobile-view select,\n"
"    .mobile-view input {\n"
"      font-size: 16px;\n"
"    }\n"
"    @media (pointer: coarse) {\n"
"      .tab-btn, .btn-action, .btn-secondary, select, .touch-control {\n"
"        min-height: 44px;\n"
"        min-width: 44px;\n"
"      }\n"
"      input[type=range]::-webkit-slider-thumb {\n"
"        width: 24px;\n"
"        height: 24px;\n"
"      }\n"
"      input[type=range]::-moz-range-thumb {\n"
"        width: 24px;\n"
"        height: 24px;\n"
"      }\n"
"    }\n"
"\n"
"    /* Responsive Breakpoints */\n"
"    @media (max-width: 900px) {\n"
"      header {\n"
"        flex-wrap: wrap;\n"
"        padding: 0.85rem 1rem;\n"
"      }\n"
"      .tab-bar {\n"
"        width: 100%;\n"
"        overflow-x: auto;\n"
"      }\n"
"      main {\n"
"        grid-template-columns: 1fr;\n"
"        padding: 1rem;\n"
"        gap: 1rem;\n"
"      }\n"
"      .props-view {\n"
"        padding: 1rem;\n"
"        gap: 1rem;\n"
"      }\n"
"      .props-summary-grid {\n"
"        grid-template-columns: repeat(2, minmax(0, 1fr));\n"
"      }\n"
"      .card {\n"
"        padding: 1rem;\n"
"      }\n"
"      .viewport-card {\n"
"        order: -1;\n"
"        min-height: 0;\n"
"        padding: 1rem;\n"
"      }\n"
"      footer {\n"
"        flex-wrap: wrap;\n"
"        padding: 0.85rem 1rem;\n"
"      }\n"
"      select, input, button {\n"
"        font-size: 16px;\n"
"      }\n"
"    }\n"
"\n"
"    @media (max-width: 600px) {\n"
"      header {\n"
"        padding: 0.75rem 0.65rem;\n"
"      }\n"
"      .logo-group {\n"
"        flex-direction: column;\n"
"        align-items: flex-start;\n"
"        gap: 0.45rem;\n"
"        width: 100%;\n"
"      }\n"
"      main {\n"
"        padding: 0.65rem;\n"
"      }\n"
"      .props-view {\n"
"        padding: 0.65rem;\n"
"      }\n"
"      .props-summary-grid {\n"
"        grid-template-columns: 1fr;\n"
"      }\n"
"      .stats-grid {\n"
"        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n"
"      }\n"
"      footer {\n"
"        padding: 0.75rem 0.65rem;\n"
"        flex-direction: column;\n"
"      }\n"
"    }\n"
"  </style>\n"
"</head>\n"
"<body>\n"
"\n"
"  <header>\n"
"    <div class=\"logo-group\">\n"
"      <div class=\"brand\">Ambarella <span>Virtualization</span> Demo Hub</div>\n"
"      <div class=\"os-badge\">\n"
"        <div id=\"statusDot\" class=\"pulse-dot\"></div>\n"
"        <span id=\"osBadgeText\">Connecting to Ambarella N1-655...</span>\n"
"      </div>\n"
"    </div>\n"
"\n"
"    <div class=\"tab-bar\">\n"
"      <button id=\"tabPropsBtn\" class=\"tab-btn active\">\n"
"        <svg width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z\"/></svg>\n"
"        Guest Properties\n"
"      </button>\n"
"      <button id=\"tabLiveBtn\" class=\"tab-btn\">\n"
"        <svg width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z\"/></svg>\n"
"        Live Camera Stream\n"
"      </button>\n"
"      <button id=\"tabUsbBtn\" class=\"tab-btn\" disabled>\n"
"        <svg width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M9 3a1 1 0 00-1 1v1H7a2 2 0 00-2 2v11a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-1V4a1 1 0 00-1-1H9zm1 2h4v1h-4V5zm2 4a3 3 0 110 6 3 3 0 010-6z\"/></svg>\n"
"        <span id=\"tabUsbLabel\">No USB Webcam on Platform</span>\n"
"      </button>\n"
"      <button id=\"tabUploadBtn\" class=\"tab-btn\">\n"
"        <svg width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z\"/></svg>\n"
"        Photo Upload\n"
"      </button>\n"
"    </div>\n"
"  </header>\n"
"\n"
"  <section id=\"propsView\" class=\"props-view\">\n"
"    <div class=\"props-header-row\">\n"
"      <div>\n"
"        <div style=\"font-size:1.15rem; font-weight:600;\">Guest Tenant &amp; Shared Memory Properties</div>\n"
"        <div style=\"font-size:0.82rem; color:var(--text-sub);\">In-process query of /dev/amba_virt (GET_INFO, CONNECT, QUERY_SELF, QUERY_DEV_MEM)</div>\n"
"      </div>\n"
"      <button id=\"propsRefreshBtn\" class=\"btn-secondary touch-control\">\n"
"        <span>Refresh</span>\n"
"      </button>\n"
"    </div>\n"
"\n"
"    <div id=\"propsErrorCard\" class=\"props-error-card\">\n"
"      <div style=\"font-weight:700; font-size:0.95rem;\">Guest Virtualization Query Unavailable</div>\n"
"      <div id=\"propsErrorText\" style=\"font-family:'JetBrains Mono', monospace; font-size:0.85rem;\"></div>\n"
"    </div>\n"
"\n"
"    <div id=\"propsOnlineContent\" style=\"display:flex; flex-direction:column; gap:1.5rem;\">\n"
"      <div class=\"props-summary-grid\">\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Tenant CID (vsock)</div>\n"
"          <div id=\"propTenantCid\" class=\"stat-val accent\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Tenant Index</div>\n"
"          <div id=\"propTenantIdx\" class=\"stat-val\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Server Reachable</div>\n"
"          <div id=\"propServerReachable\" class=\"stat-val emerald\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Shared Memory BAR Size</div>\n"
"          <div id=\"propBarSize\" class=\"stat-val\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Device Partition Union vs BAR</div>\n"
"          <div id=\"propPartitionUsage\" class=\"stat-val accent\">--</div>\n"
"          <div class=\"gauge-track\"><div id=\"propPartitionGauge\" class=\"gauge-fill\"></div></div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Allocated by server (incl. MEM_ALLOC)</div>\n"
"          <div id=\"propServerAllocMb\" class=\"stat-val\">--</div>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"card\">\n"
"        <div class=\"card-title\">\n"
"          <span>Granted Capabilities</span>\n"
"          <span id=\"propCapsHex\" class=\"det-tag\" style=\"background:rgba(0,229,255,0.1); color:var(--accent);\">0x00000000</span>\n"
"        </div>\n"
"        <div id=\"propCapsList\" class=\"caps-pill-list\"></div>\n"
"      </div>\n"
"\n"
"      <div class=\"card\">\n"
"        <div class=\"card-title\">\n"
"          <span>Proportional Shared Memory BAR Map (Device Partitions Only)</span>\n"
"          <span style=\"font-size:0.78rem; text-transform:none; font-weight:400;\">NO PARTITION ranges mean no device partition covers that range; see Allocated by server (incl. MEM_ALLOC) for total server allocations.</span>\n"
"        </div>\n"
"        <div class=\"map-scroll-wrap\">\n"
"          <div id=\"propMapBar\" class=\"bar-map\"></div>\n"
"        </div>\n"
"        <div class=\"map-legend\">\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(0,229,255,0.45);\"></span>CAVALRY (NPU)</span>\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(59,130,246,0.65);\"></span>RPC Arena</span>\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(16,185,129,0.55);\"></span>GDMA</span>\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(168,85,247,0.55);\"></span>IAV</span>\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(245,158,11,0.55);\"></span>SCRATCH</span>\n"
"          <span class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:rgba(51,65,85,0.75);\"></span>NO PARTITION</span>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"card\">\n"
"        <div class=\"card-title\">\n"
"          <span>Virtual Device Partitions</span>\n"
"          <span id=\"propDevicesCount\" class=\"det-tag\" style=\"background:rgba(16,185,129,0.12); color:#34d399;\">0 devices</span>\n"
"        </div>\n"
"        <div class=\"table-scroll-wrap\">\n"
"          <table class=\"props-table\">\n"
"            <thead>\n"
"              <tr>\n"
"                <th>Device Type</th>\n"
"                <th>BAR Offset</th>\n"
"                <th>End Offset</th>\n"
"                <th>Size</th>\n"
"                <th>RPC Arena</th>\n"
"              </tr>\n"
"            </thead>\n"
"            <tbody id=\"propDevicesBody\"></tbody>\n"
"          </table>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"card\">\n"
"        <div class=\"card-title\">\n"
"          <span>BAR Extent Map</span>\n"
"        </div>\n"
"        <div class=\"table-scroll-wrap\">\n"
"          <table class=\"props-table\">\n"
"            <thead>\n"
"              <tr>\n"
"                <th>Status</th>\n"
"                <th>Usage</th>\n"
"                <th>Start Offset</th>\n"
"                <th>End Offset</th>\n"
"                <th>Size</th>\n"
"              </tr>\n"
"            </thead>\n"
"            <tbody id=\"propExtentsBody\"></tbody>\n"
"          </table>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <details class=\"card props-details\">\n"
"        <summary class=\"card-title\">\n"
"          <span>CLI Layout Text (amba-virt-cli layout)</span>\n"
"        </summary>\n"
"        <pre id=\"propLayoutText\" class=\"layout-pre\"></pre>\n"
"      </details>\n"
"    </div>\n"
"  </section>\n"
"\n"
"  <main id=\"streamMain\" style=\"display:none;\">\n"
"    <!-- Left Column: Controls & Telemetry -->\n"
"    <div class=\"card\">\n"
"      <div class=\"card-title\">\n"
"        <span>Hardware Telemetry</span>\n"
"        <span id=\"streamStateBadge\" class=\"det-tag\" style=\"background:rgba(0,229,255,0.1); color:var(--accent);\">STANDBY</span>\n"
"      </div>\n"
"\n"
"      <div class=\"stats-grid\">\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">VisORC Execution</div>\n"
"          <div id=\"statVisorcMs\" class=\"stat-val accent\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">In-Guest Total</div>\n"
"          <div id=\"statTotalMs\" class=\"stat-val emerald\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Stream FPS</div>\n"
"          <div id=\"statFps\" class=\"stat-val\">--</div>\n"
"        </div>\n"
"        <div class=\"stat-box\">\n"
"          <div class=\"stat-label\">Active Detections</div>\n"
"          <div id=\"statCount\" class=\"stat-val\">0</div>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"card-title\" style=\"margin-top:0.5rem;\">Inference Parameters</div>\n"
"\n"
"      <div class=\"control-group\">\n"
"        <div class=\"control-label\">\n"
"          <span>Confidence Filter</span>\n"
"          <span id=\"threshVal\">0.25</span>\n"
"        </div>\n"
"        <input type=\"range\" id=\"threshSlider\" min=\"0.05\" max=\"0.95\" step=\"0.05\" value=\"0.25\">\n"
"      </div>\n"
"\n"
"      <div class=\"control-group\">\n"
"        <div class=\"control-label\">\n"
"          <span>NMS IoU Threshold</span>\n"
"          <span id=\"nmsVal\">0.45</span>\n"
"        </div>\n"
"        <input type=\"range\" id=\"nmsSlider\" min=\"0.10\" max=\"0.90\" step=\"0.05\" value=\"0.45\">\n"
"      </div>\n"
"\n"
"      <div id=\"uploadControls\" style=\"display:none; flex-direction:column; gap:0.75rem;\">\n"
"        <button id=\"inferBtn\" class=\"btn-action\">Run VisORC Inference</button>\n"
"      </div>\n"
"\n"
"      <div id=\"usbControls\" style=\"display:none; flex-direction:column; gap:0.75rem;\">\n"
"        <div class=\"control-group\">\n"
"          <div class=\"control-label\">\n"
"            <span>USB Capture</span>\n"
"            <span id=\"usbResLabel\">1280x720@30</span>\n"
"          </div>\n"
"          <select id=\"usbRes\" style=\"background:#0d1321; color:#f8fafc; border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:0.55rem;\">\n"
"            <option value=\"720\">1280x720@30</option>\n"
"            <option value=\"1080\">1920x1080@30</option>\n"
"          </select>\n"
"        </div>\n"
"        <div class=\"control-group\">\n"
"          <div class=\"control-label\">\n"
"            <span>Pre-processing</span>\n"
"            <span id=\"usbPathLabel\">--</span>\n"
"          </div>\n"
"          <select id=\"usbBackend\" style=\"background:#0d1321; color:#f8fafc; border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:0.55rem;\">\n"
"            <option value=\"hw\">Virtualized IAV Hardware</option>\n"
"            <option value=\"cpu\">Software CPU Baseline</option>\n"
"          </select>\n"
"        </div>\n"
"        <div class=\"control-group\">\n"
"          <div class=\"control-label\">\n"
"            <span>Exposure</span>\n"
"            <span id=\"usbExposureLabel\">Auto (camera)</span>\n"
"          </div>\n"
"          <select id=\"usbExposure\" style=\"background:#0d1321; color:#f8fafc; border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:0.55rem;\">\n"
"            <option value=\"auto\">Auto (camera)</option>\n"
"            <option value=\"fixed\">Fixed exposure (30 fps)</option>\n"
"          </select>\n"
"        </div>\n"
"        <div id=\"usbGainGroup\" class=\"control-group\" style=\"display:none;\">\n"
"          <div class=\"control-label\">\n"
"            <span>Gain (fixed exposure)</span>\n"
"            <span id=\"usbGainVal\">200</span>\n"
"          </div>\n"
"          <input type=\"range\" id=\"usbGain\" min=\"16\" max=\"255\" step=\"1\" value=\"200\">\n"
"        </div>\n"
"        <div class=\"stats-grid\" id=\"usbStatsGrid\">\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Capture</div><div id=\"usbStatCapture\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Decode</div><div id=\"usbStatDecode\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Scale</div><div id=\"usbStatScale\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Color Convert</div><div id=\"usbStatConvert\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">NPU (VisORC)</div><div id=\"usbStatNpu\" class=\"stat-val accent\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Post-process</div><div id=\"usbStatPost\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Camera FPS</div><div id=\"usbStatCamFps\" class=\"stat-val\">--</div></div>\n"
"          <div class=\"stat-box\"><div class=\"stat-label\">Processed FPS</div><div id=\"usbStatFps\" class=\"stat-val emerald\">--</div></div>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"card-title\" style=\"margin-top:0.5rem;\">Detected Objects</div>\n"
"      <div id=\"detList\" class=\"det-list\">\n"
"        <div style=\"text-align: center; color: var(--text-sub); font-size: 0.85rem; padding: 1rem;\">\n"
"          No active detections\n"
"        </div>\n"
"      </div>\n"
"    </div>\n"
"\n"
"    <!-- Right Column: Viewport -->\n"
"    <div class=\"viewport-card\">\n"
"      <div class=\"viewport-header\">\n"
"        <div style=\"font-weight:600; font-size:1.05rem;\" id=\"viewportTitle\">Live Sensor Viewport (Clean JPEG + VisORC Overlay)</div>\n"
"        <div style=\"display:flex; gap:0.5rem;\">\n"
"          <button id=\"pauseBtn\" class=\"btn-secondary\">\n"
"            <svg id=\"pauseIcon\" width=\"14\" height=\"14\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/></svg>\n"
"            <span id=\"pauseBtnText\">Pause</span>\n"
"          </button>\n"
"        </div>\n"
"      </div>\n"
"\n"
"      <div class=\"canvas-container\">\n"
"        <!-- Live Stream Canvas -->\n"
"        <canvas id=\"liveCanvas\" width=\"640\" height=\"360\"></canvas>\n"
"\n"
"        <!-- Photo Upload Dropzone (shown on tab switch) -->\n"
"        <div id=\"uploadZone\" class=\"upload-zone\" style=\"display:none;\">\n"
"          <svg width=\"48\" height=\"48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" style=\"color:var(--text-sub);\">\n"
"            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z\" />\n"
"          </svg>\n"
"          <div style=\"text-align:center;\">\n"
"            <div style=\"font-weight:600; font-size:1rem; margin-bottom:0.25rem;\">Drop image here or click to browse</div>\n"
"            <div style=\"font-size:0.8rem; color:var(--text-sub);\">JPEG, PNG supported (Processed by VisORC hardware)</div>\n"
"          </div>\n"
"          <input type=\"file\" id=\"fileInput\" accept=\"image/*\" style=\"display:none;\">\n"
"          <canvas id=\"uploadCanvas\"></canvas>\n"
"        </div>\n"
"      </div>\n"
"    </div>\n"
"  </main>\n"
"\n"
"  <footer>\n"
"    <div>Ambarella International LLC &mdash; N1-655 VisORC Neural Virtualization Engine</div>\n"
"    <div id=\"footerStatus\">Protocol: Nanopb v1 RPC | Clean JPEG Ping-Pong Architecture</div>\n"
"  </footer>\n"
"\n"
"  <script>\n"
"    /* Color Palette for 10 distinct classes */\n"
"    const CLASS_COLORS = [\n"
"      { border: 'rgb(59, 130, 246)', bg: 'rgba(59, 130, 246, 0.15)' },\n"
"      { border: 'rgb(16, 185, 129)', bg: 'rgba(16, 185, 129, 0.15)' },\n"
"      { border: 'rgb(245, 158, 11)',  bg: 'rgba(245, 158, 11, 0.15)' },\n"
"      { border: 'rgb(239, 68, 68)',   bg: 'rgba(239, 68, 68, 0.15)' },\n"
"      { border: 'rgb(168, 85, 247)', bg: 'rgba(168, 85, 247, 0.15)' },\n"
"      { border: 'rgb(236, 72, 153)', bg: 'rgba(236, 72, 153, 0.15)' },\n"
"      { border: 'rgb(6, 182, 212)',  bg: 'rgba(6, 182, 212, 0.15)' },\n"
"      { border: 'rgb(132, 204, 22)', bg: 'rgba(132, 204, 22, 0.15)' },\n"
"      { border: 'rgb(249, 115, 22)', bg: 'rgba(249, 115, 22, 0.15)' },\n"
"      { border: 'rgb(147, 51, 234)', bg: 'rgba(147, 51, 234, 0.15)' }\n"
"    ];\n"
"\n"
"    function detectViewerProfile(navigatorLike, matchMediaFn) {\n"
"      const nav = navigatorLike || {};\n"
"      const ua = String(nav.userAgent || '');\n"
"      const plat = String(nav.platform || '');\n"
"      const uaData = (nav.userAgentData && typeof nav.userAgentData === 'object') ? nav.userAgentData : null;\n"
"      const uaDataPlat = uaData && uaData.platform ? String(uaData.platform) : '';\n"
"      const maxTouch = typeof nav.maxTouchPoints === 'number' ? nav.maxTouchPoints : 0;\n"
"      const queryMatches = (q) => {\n"
"        if (typeof matchMediaFn !== 'function') return false;\n"
"        try {\n"
"          const m = matchMediaFn(q);\n"
"          return !!(m && m.matches);\n"
"        } catch (e) {\n"
"          return false;\n"
"        }\n"
"      };\n"
"      const narrow = queryMatches('(max-width: 900px)');\n"
"      const coarse = queryMatches('(pointer: coarse)');\n"
"      const touch = (maxTouch > 0) || coarse;\n"
"\n"
"      let platform = 'other';\n"
"      if (/android/i.test(uaDataPlat) || /android/i.test(ua)) {\n"
"        platform = 'android';\n"
"      } else if (\n"
"        /iPhone|iPad|iPod/i.test(uaDataPlat) ||\n"
"        /iPhone|iPad|iPod/i.test(plat) ||\n"
"        /iPhone|iPad|iPod/i.test(ua) ||\n"
"        (plat === 'MacIntel' && maxTouch > 1)\n"
"      ) {\n"
"        platform = 'ios';\n"
"      }\n"
"\n"
"      const uaMobile = !!(uaData && uaData.mobile === true);\n"
"      const mobile = (platform === 'android') || (platform === 'ios') || uaMobile || (narrow && coarse);\n"
"\n"
"      return { platform, mobile, touch, narrow };\n"
"    }\n"
"\n"
"    function applyViewerProfile() {\n"
"      const mm = (typeof window !== 'undefined' && typeof window.matchMedia === 'function')\n"
"        ? window.matchMedia.bind(window)\n"
"        : null;\n"
"      const profile = detectViewerProfile(typeof navigator !== 'undefined' ? navigator : {}, mm);\n"
"      const root = document.documentElement;\n"
"      root.classList.toggle('platform-android', profile.platform === 'android');\n"
"      root.classList.toggle('platform-ios', profile.platform === 'ios');\n"
"      root.classList.toggle('touch-view', profile.touch);\n"
"      root.classList.toggle('mobile-view', profile.mobile);\n"
"      return profile;\n"
"    }\n"
"\n"
"    if (typeof window !== 'undefined' && typeof window.matchMedia === 'function') {\n"
"      const mqNarrow = window.matchMedia('(max-width: 900px)');\n"
"      const mqCoarse = window.matchMedia('(pointer: coarse)');\n"
"      if (mqNarrow && typeof mqNarrow.addEventListener === 'function') {\n"
"        mqNarrow.addEventListener('change', applyViewerProfile);\n"
"      }\n"
"      if (mqCoarse && typeof mqCoarse.addEventListener === 'function') {\n"
"        mqCoarse.addEventListener('change', applyViewerProfile);\n"
"      }\n"
"      window.addEventListener('resize', applyViewerProfile);\n"
"    }\n"
"\n"
