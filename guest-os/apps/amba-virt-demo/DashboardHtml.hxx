"          tdStatus.appendChild(cBadge);\n"
"        }\n"
"        if (ext.overlaps) {\n"
"          const oBadge = document.createElement('span');\n"
"          oBadge.className = 'extent-badge warn';\n"
"          oBadge.textContent = 'OVERLAPS';\n"
"          tdStatus.appendChild(oBadge);\n"
"        }\n"
"        const tdUsage = document.createElement('td');\n"
"        tdUsage.textContent = String(ext.usage || '');\n"
"        const tdStart = document.createElement('td');\n"
"        tdStart.className = 'mono-cell';\n"
"        tdStart.textContent = formatHex64(ext.start_offset);\n"
